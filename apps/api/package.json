{
  "name": "@yegna/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types --check && tsc -p .",
    "types": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:seed:local": "node ../../packages/db/scripts/seed.ts .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "db:seed:staging": "node ../../packages/db/scripts/seed.ts .wrangler/seed.sql && wrangler d1 execute DB --remote --env staging --file .wrangler/seed.sql",
    "deploy:staging": "wrangler deploy --env staging",
    "backup": "node --experimental-transform-types --no-warnings scripts/backup.ts",
    "restore": "node --experimental-transform-types --no-warnings scripts/restore.ts",
    "google-auth": "node --experimental-transform-types --no-warnings scripts/google-auth.ts",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@yegna/ai": "workspace:*",
    "@yegna/db": "workspace:*",
    "@yegna/shared": "workspace:*",
    "@yegna/time": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "grammy": "1.46.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
