{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yegna-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One hourly cron (PRD §16, §19); jobs dispatch by Addis Ababa local time (src/jobs/dispatch.ts).
  "triggers": { "crons": ["0 * * * *"] },
  // Local development (wrangler dev): local D1 only.
  "vars": { "ENVIRONMENT": "local", "PWA_ORIGIN": "http://localhost:5173" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yegna-staging",
      "database_id": "f9befc08-c200-4856-b84d-6d648e920346",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "yegna-api-staging",
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "PWA_ORIGIN": "https://yegna-pwa-staging.yegna-api.workers.dev",
        // The staging test bot (docs/runbooks/team-bot.md); its token and webhook secret are secrets.
        "TEAM_BOT_USERNAME": "YengaTeamTestBot",
      },
      // Workers AI: the first free schedule reader (ADR 0009). Not in local dev (it is remote only).
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yegna-staging",
          "database_id": "f9befc08-c200-4856-b84d-6d648e920346",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
    // Production on the free workers.dev subdomain until the domain is decided (ADR 0001, ADR 0013).
    // Deployed only by hand (the "Deploy production" workflow). Bot usernames are added once the
    // clinic's real bots exist (docs/runbooks/production.md).
    "production": {
      "name": "yegna-api",
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "PWA_ORIGIN": "https://yegna-pwa.yegna-api.workers.dev",
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yegna-production",
          "database_id": "fcec4bf2-f261-44ac-aa83-d40b2d242322",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
    },
  },
}
