  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "6.2.7",
    "vite": "^8.3.7",
    "wrangler": "4.158.0"
  }
