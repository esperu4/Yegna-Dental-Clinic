{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // PWA shell served as Workers static assets (the current form of Cloudflare Pages).
  "name": "yegna-pwa",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": { "name": "yegna-pwa-staging" },
    // Deployed only by hand (the "Deploy production" workflow, docs/runbooks/production.md).
    "production": { "name": "yegna-pwa" },
  },
}
