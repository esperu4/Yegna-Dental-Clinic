{
  "name": "@yegna/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fonts.mjs",
    "typecheck": "astro check",
    "test": "pnpm build && node scripts/budget.mjs",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "budget": "node scripts/budget.mjs",
    "deploy:production": "astro build --site https://yegna-web.yegna-api.workers.dev && node scripts/fonts.mjs && wrangler deploy --env production"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "^5.3.0",
    "@yegna/shared": "workspace:*",
    "@yegna/time": "workspace:*",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "wrangler": "4.158.0"
  }
}
