---
/** Placeholder mark until the brand kit exists (PRD §15): a tooth outline in hairline strokes. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="tooth-mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path
    d="M10 4c-4 0-6 3-6 7 0 5 2 7 3 11 1 4 2 6 3.5 6s2-3 2.5-6c.4-2 1.2-3 3-3s2.6 1 3 3c.5 3 1 6 2.5 6s2.5-2 3.5-6c1-4 3-6 3-11 0-4-2-7-6-7-2.5 0-3.6 1.2-6 1.2S12.5 4 10 4Z"
  ></path>
  <path d="M11 9.5c1.6.8 3.2 1 5 1s3.4-.2 5-1" opacity="0.6"></path>
</svg>
