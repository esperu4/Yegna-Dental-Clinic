---
/** All pages in both languages (PRD §15): Amharic at `/…/`, English at `/en/…/`. */
import { getCollection, render } from 'astro:content';
import { CLINIC, displayPhone, mapsUrl, telegramUrl } from '@yegna/shared';
import { formatEtTime } from '@yegna/time';
import Base from '../layouts/Base.astro';
import ToothDiagram from '../components/ToothDiagram.astro';
import { type Locale, type Page, NAV, TEXT, pathOf } from '../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries.map((entry) => {
    const [locale, page] = entry.id.split('/') as [Locale, Page];
    const path = pathOf(locale, page).replace(/^\/|\/$/g, '');
    return { params: { slug: path || undefined }, props: { entry, locale, page } };
  });
}

const { entry, locale, page } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const phone = CLINIC.phones[0];
const toMinutes = (hhmm: string) => Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3));
const { opens, closes } = CLINIC.openingHours;
const etHours = `${formatEtTime(toMinutes(opens), locale)} – ${formatEtTime(toMinutes(closes), locale)}`;
const clockHours = `${opens} – ${closes}`;
const withDiagram = page === 'home' || page === 'services';
const faqLd = data.faqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined;
---

<Base locale={locale} page={page} title={data.title} description={data.description} jsonLd={faqLd}>
  <section class:list={['opening', { 'with-diagram': withDiagram, home: page === 'home' }]}>
    <div class="opening-text">
      <h1>{data.heading}</h1>
      <p class="lead">{data.lead}</p>
      <p class="actions">
        <a class="button primary" href={`tel:${phone}`}>{TEXT.callLong[locale]}</a>
        <a class="button" href={telegramUrl()} rel="noopener">{TEXT.telegram[locale]}</a>
      </p>
    </div>
    {withDiagram ? <ToothDiagram locale={locale} /> : null}
  </section>

  {
    page === 'home' || page === 'contact' ? (
      <section class="visit" aria-label={TEXT.visit[locale]}>
        <div>
          <h2>{TEXT.hours[locale]}</h2>
          <p>{TEXT.days[locale]}</p>
          <p class="big">{etHours}</p>
          <p class="small">{TEXT.clock[locale]} {clockHours}</p>
        </div>
        <div>
          <h2>{TEXT.address[locale]}</h2>
          <p>{CLINIC.address[locale]}</p>
          <p>
            <a href={mapsUrl()} rel="noopener">
              {TEXT.maps[locale]}
            </a>
          </p>
        </div>
        <div>
          <h2>{TEXT.phone[locale]}</h2>
          {CLINIC.phones.map((p) => (
            <p class="big">
              <a href={`tel:${p}`}>{displayPhone(p)}</a>
            </p>
          ))}
          <p class="small">{TEXT.byPhone[locale]}</p>
        </div>
      </section>
    ) : null
  }

  <section class="prose">
    <Content />
  </section>

  {
    page === 'home' ? (
      <section class="services" aria-label={TEXT.ourServices[locale]}>
        <h2>{TEXT.ourServices[locale]}</h2>
        <dl>
          {CLINIC.services.map((s) => (
            <div>
              <dt>{s.name[locale]}</dt>
              <dd>{s.about[locale]}</dd>
            </div>
          ))}
        </dl>
        <p class="note">
          {TEXT.noPrices[locale]} <a href={pathOf(locale, 'services')}>{NAV.services[locale]}</a>
        </p>
      </section>
    ) : null
  }

  {page === 'services' ? <p class="note">{TEXT.noPrices[locale]}</p> : null}

  {
    data.faqs ? (
      <section class="faq">
        {data.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    ) : null
  }
</Base>
