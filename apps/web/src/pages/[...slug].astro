---
/** All pages in both languages (PRD §15): Amharic at `/…/`, English at `/en/…/`. */
import { getCollection, render } from 'astro:content';
import { CLINIC, displayPhone, mapsUrl, telegramUrl } from '@yegna/shared';
import { formatEtTime } from '@yegna/time';
import Base from '../layouts/Base.astro';
import ToothMark from '../components/ToothMark.astro';
import { type Locale, type Page, NAV, PAGES, TEXT, pathOf } from '../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries.map((entry) => {
    const [locale, page] = entry.id.split('/') as [Locale, Page];
    const path = pathOf(locale, page).replace(/^\/|\/$/g, '');
    return { params: { slug: path || undefined }, props: { entry, locale, page } };
  });
}

const { entry, locale, page } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const phone = CLINIC.phones[0];
const minutes = (hhmm: string) => Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3));
const hours = `${TEXT.days[locale]}, ${formatEtTime(minutes(CLINIC.openingHours.opens), locale)} – ${formatEtTime(minutes(CLINIC.openingHours.closes), locale)}`;
const faqLd = data.faqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined;
---

<Base locale={locale} page={page} title={data.title} description={data.description} jsonLd={faqLd}>
  <section class={page === 'home' ? 'hero' : 'intro'}>
    {page === 'home' ? <ToothMark size={56} /> : null}
    <h1>{data.heading}</h1>
    <p class="lead">{data.lead}</p>
    <p class="actions">
      <a class="button primary" href={`tel:${phone}`}>{TEXT.callLong[locale]}</a>
      <a class="button" href={telegramUrl()} rel="noopener">{TEXT.telegram[locale]}</a>
    </p>
  </section>

  <section class="prose">
    <Content />
  </section>

  {
    page === 'home' ? (
      <section class="cards" aria-label={TEXT.ourServices[locale]}>
        {CLINIC.services.map((s) => (
          <article class="card">
            <h2>{s.name[locale]}</h2>
            <p>{s.about[locale]}</p>
          </article>
        ))}
        <p class="note">
          <a href={pathOf(locale, 'services')}>{NAV.services[locale]} ›</a> · {TEXT.noPrices[locale]}
        </p>
      </section>
    ) : null
  }

  {page === 'services' ? <p class="note">{TEXT.noPrices[locale]}</p> : null}

  {
    page === 'contact' ? (
      <section class="card contact">
        <h2>{TEXT.address[locale]}</h2>
        <p>{CLINIC.address[locale]}</p>
        <p>
          <a href={mapsUrl()} rel="noopener">
            {TEXT.maps[locale]}
          </a>
        </p>
        <h2>{TEXT.phone[locale]}</h2>
        <p>
          {CLINIC.phones.map((p) => (
            <a href={`tel:${p}`}>{displayPhone(p)}</a>
          ))}
        </p>
        <h2>{TEXT.hours[locale]}</h2>
        <p>{hours}</p>
      </section>
    ) : null
  }

  {
    data.faqs ? (
      <section class="faq">
        {data.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    ) : null
  }
</Base>
